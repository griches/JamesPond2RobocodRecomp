diff --git a/src/filesystem/unix/SDL_sysfilesystem.c b/src/filesystem/unix/SDL_sysfilesystem.c
index a23d67b..1786134 100644
--- a/src/filesystem/unix/SDL_sysfilesystem.c
+++ b/src/filesystem/unix/SDL_sysfilesystem.c
@@ -240,6 +240,10 @@ static char *GetExePath(void)
 
 char *SDL_SYS_GetBasePath(void)
 {
+#ifdef __PROSPERO__
+    // PlayStation 5: a title's own folder is mounted at /app0
+    return SDL_strdup("/app0/");
+#else
     char *path = GetExePath();
     if (!path) {
         return NULL;
@@ -252,6 +256,7 @@ char *SDL_SYS_GetBasePath(void)
 
     ptr = (char *) SDL_realloc(path, ((size_t) (ptr - path)) + 2);  // try to shrink this allocation down a little.
     return ptr ? ptr : path;  // return shrunk buffer if shrink worked out, unchanged original buffer if not.
+#endif // __PROSPERO__
 }
 
 
diff --git a/src/gpu/vulkan/SDL_gpu_vulkan.c b/src/gpu/vulkan/SDL_gpu_vulkan.c
index 2782f41..7a4939b 100644
--- a/src/gpu/vulkan/SDL_gpu_vulkan.c
+++ b/src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -12149,7 +12149,13 @@ static bool VULKAN_INTERNAL_GetDeviceRank(
             &physicalDeviceProperties);
 
         if (physicalDeviceExtensions->KHR_driver_properties) {
+#ifdef __PROSPERO__
+            /* PlayStation 5: the console's RADV reports conformanceVersion 0.0.0.0
+             * until it passes the whole CTS there; it is the only GPU there is */
+            isConformant = true;
+#else
             isConformant = (physicalDeviceDriverProperties.conformanceVersion.major >= 1);
+#endif
         } else {
             isConformant = true; // We can't check this, so just assume it's conformant
         }
